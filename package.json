{
  "name": "rotmg-dungeon-timer",
  "version": "2.8.1",
  "private": true,
  "description": "RotMG dungeon clear timer with shared leaderboard",
  "type": "module",
  "scripts": {
    "start": "python3 serve.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
